{
  "name": "pholo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:types": "npm run build --workspace=packages/types"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/ws": "^8.18.1"
  }
}
